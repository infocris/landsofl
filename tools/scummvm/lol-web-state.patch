+// Version web (emscripten) : publie l'état du jeu pour la mini-carte de la page, sous la forme
+// de zones d'octets placées aux adresses physiques du jeu DOS (docs/reverse-engineering.md, § 12)
+// et rangées comme dans le jeu DOS (structures compactées, pointeurs sur 4 octets mis à 0).
+// La page répond avec ces zones sur le canal « lol-mem » comme l'émulateur DOSBox.
+// Format : (adresse u32, longueur u32, octets)…, petit-boutiste.
+void LoLEngine::webPublishState(bool mainLoop) {
+#ifdef __EMSCRIPTEN__
+	static uint32 lastTime = 0;
+	static Common::Array<byte> buf;
+	const uint32 now = _system->getMillis();
+	if (mainLoop) {
+		_webLoopCount++;
+		_webLoadingLevel = false;
+	}
+	const bool changed = mainLoop && EM_ASM_INT({ return Module.lolCmds && Module.lolCmds.length ? 1 : 0; });
+	if (changed)
+		webRunCommands();
+	// attaque automatique : chaque personnage prêt frappe le monstre le plus proche de la case
+	// devant le groupe, comme un clic sur son arme (clickedAttackButton). Monstres paisibles
+	// (mode 1, ex. gardes de Gladstone) et mourants (mode >= 13) épargnés.
+	// Personnage réglé sur un sort (_webAutoSpell) : sort lancé au plus haut niveau que sa magie et
+	// sa vie permettent, sur un monstre hostile jusqu'à 3 cases devant (getSpellTargetBlock) ;
+	// pas assez de magie : arme.
+	if (mainLoop && _webAutoAttack && !(_updateFlags & 0x0F) && !_weaponsDisabled && _activeMagicMenu == -1 && now - _webAutoAttackTime >= 200) {
+		_webAutoAttackTime = now;
+		auto hostileAt = [&](uint16 block) {
+			if (block > 1023)
+				return false;
+			int o = _levelBlockProperties[block].assignedObjects;
+			while (o & 0x8000) {
+				const LoLMonster *m = &_monsters[o & 0x7FFF];
+				if (m->mode < 13 && m->mode != 1)
+					return true;
+				o = m->nextAssignedObject;
+			}
+			return false;
+		};
+		for (int i = 0; i < 4; i++) {
+			if (!(_characters[i].flags & 1) || (_characters[i].flags & 0x314C))
+				continue;
+			const int sp = _webAutoSpell[i];
+			if (sp != 0xFF && _spellProperties) {
+				uint16 tb = 0xFFFF;
+				getSpellTargetBlock(_currentBlock, _currentDirection, 3, tb);
+				if (tb != 0xFFFF && hostileAt(tb)) {
+					int lvl = -1;
+					for (int l = 3; l >= 0 && lvl < 0; l--)
+						if (_spellProperties[sp].mpRequired[l] <= _characters[i].magicPointsCur && _spellProperties[sp].hpRequired[l] < _characters[i].hitPointsCur)
+							lvl = l;
+					if (lvl >= 0 && webCastSpell(i, sp, lvl, -1) == 0)
+						continue;
+				}
+			}
+			if (_characters[i].flags & 0x314C)
+				continue;
+			const uint16 t = getNearestMonsterFromCharacter(i);
+			if (t == 0xFFFF || !(t & 0x8000) || _monsters[t & 0x7FFF].mode == 1)
+				continue;
+			Button b;
+			b.arg = i;
+			clickedAttackButton(&b);
+		}
+	}
+	for (int i = 0; i < 4 && mainLoop; i++) {	// triches : remettre au maximum (ce qui a été perdu avant l'activation)
+		LoLCharacter &c = _characters[i];
+		if (!(c.flags & 1) || (c.flags & 8))
+			continue;
+		if (_webInfiniteHp && c.hitPointsCur < (int)c.hitPointsMax)
+			setCharacterMagicOrHitPoints(i, 0, c.hitPointsMax, 0);
+		if (_webInfiniteMp && c.magicPointsCur < (int)c.magicPointsMax)
+			setCharacterMagicOrHitPoints(i, 1, c.magicPointsMax, 0);
+	}
+	if (now - lastTime < (mainLoop ? 150u : 100u) && !changed)
+		return;
+	lastTime = now;
+	buf.clear();
+	uint32 start = 0;
+	auto u8 = [&](uint32 v) { buf.push_back(v & 0xFF); };
+	auto u16 = [&](uint32 v) { u8(v); u8(v >> 8); };
+	auto u32 = [&](uint32 v) { u16(v); u16(v >> 16); };
+	auto begin = [&](uint32 addr) { u32(addr); start = buf.size(); u32(0); };
+	auto end = [&]() { const uint32 n = buf.size() - start - 4; for (int i = 0; i < 4; i++) buf[start + i] = (n >> (8 * i)) & 0xFF; };
+
+	begin(0x3E4E0); u16(_currentBlock); end();
+	begin(0x3E4EF); u16(_currentDirection); end();
+	// niveau en cours (u8) : les niveaux 2 et 3 (forêts du Nord et du Sud) ont la même carte à
+	// 4 faces près, la page ne peut pas les distinguer par la grille
+	begin(0x7F000A00); u8(_currentLevel); end();
+	begin(0x5D6B5); u8(_specialSceneFlag ? 1 : 5); end();
+	begin(0x3E6F0); u16(_credits); end();
+	begin(0x3E558); u16(_itemInHand); end();
+	begin(0x3E4F6); for (int i = 0; i < 48; i++) u16(_inventory[i]); end();
+	begin(0x3E55C); for (int i = 0; i < 128; i++) u8(i < (int)sizeof(_flagsTable) ? _flagsTable[i] : 0); end();
+	begin(0x30270); for (int i = 0; i < 11; i++) u32(_expRequirements ? _expRequirements[i] : 0); end();
+	// sprites des monstres (zone propre à la version web, hors de la mémoire DOS) : pour chacun des
+	// 5 types de monstres, nom (13 octets) du fichier chargé dans son emplacement (shapeIndex)
+	// affichage (zone propre à la version web) : scène spéciale, _updateFlags, fenêtre de séquence
+	// (x1, y1, x2, y2), menu ouvert, tours de la boucle principale (s'arrêtent pendant dialogues,
+	// séquences et cinématiques, qui ont leurs propres boucles)
+	begin(0x7F000100);
+	u8(_specialSceneFlag ? 1 : 0); u16(_updateFlags);
+	u16(_seqWindowX1); u16(_seqWindowY1); u16(_seqWindowX2); u16(_seqWindowY2);
+	u8(_webInMenu ? 1 : 0); u32(_webLoopCount); u8(_webLoadingLevel ? 1 : 0); u8(_webCasting ? 1 : 0);
+	end();
+	// image de chaque monstre telle que le jeu la dessine vu du groupe (drawMonster), 4 octets :
+	// numéro d'image (0-15, 255 = aucune) ; 1 = image retournée horizontalement ; giclée de coup
+	// reçu (image 6 de GAMESHP.SHP) : réduction 1-4 (0 = aucune) ; couleur 0-3 (drapeaux & 0xC000)
+	begin(0x7F000200);
+	for (int i = 0; i < 30; i++) {
+		LoLMonster *m = &_monsters[i];
+		int frm = -1, flip = 0, blood = 0, bloodType = 0;
+		if (m->properties && _monsterDirFlags && m->block) {
+			const int16 flg = _monsterDirFlags[(_currentDirection << 2) + (m->facing & 3)];
+			frm = getMonsterCurFrame(m, flg & 0xFFEF);
+			flip = (flg & 0x10) ? 1 : 0;
+			if (m->damageReceived && frm >= 0) {
+				const int dmg = m->damageReceived & 0x7FFF;
+				int amount = (m->mode == 13) ? (m->fightCurTick << 1) : (dmg ? m->properties->hitPoints / dmg : 4);
+				blood = CLIP(amount, 1, 4);
+				bloodType = (m->properties->flags & 0xC000) >> 14;
+			}
+		}
+		u8(frm < 0 || frm > 15 ? 255 : frm); u8(flip); u8(blood); u8(bloodType);
+	}
+	end();
+	// sorts connus du groupe (version web) : 7 entrées de 48 octets
+	// type (i8, -1 = aucun), 0, magie requise u16 × 4 niveaux, vie requise u16 × 4, nom (30 octets, CP850)
+	begin(0x7F000300);
+	for (int i = 0; i < 7; i++) {
+		const int t = _availableSpells[i];
+		u8(t < 0 ? 0xFF : t); u8(0);
+		for (int l = 0; l < 4; l++) u16(t < 0 ? 0 : _spellProperties[t].mpRequired[l]);
+		for (int l = 0; l < 4; l++) u16(t < 0 ? 0 : _spellProperties[t].hpRequired[l]);
+		const char *n = t < 0 ? "" : getLangString(_spellProperties[t].spellNameCode);
+		for (int k = 0; k < 30; k++) u8(n && k < (int)strlen(n) ? (uint8)n[k] : 0);
+	}
+	end();
+	// points de vie maximum des 5 types de monstres du niveau (u16 ; type = champ +32 du monstre),
+	// puis leurs drapeaux (u16 ; 0x800 = translucide, 0x200 = image retournée, 0xC000 = sang)
+	begin(0x7F000900);
+	for (int t = 0; t < 5; t++) u16(_monsterProperties ? _monsterProperties[t].hitPoints : 0);
+	for (int t = 0; t < 5; t++) u16(_monsterProperties ? _monsterProperties[t].flags : 0);
+	end();
+	// carte automatique du jeu, tous niveaux : niveaux visités (u32, bit n-1 = niveau n ; _hasTempDataFlags,
+	// plus le niveau en cours), puis 29 × 128 octets (bit i&7 de l'octet i>>3 : case i marquée, flags & 7).
+	// Niveau en cours : grille vivante ; autres : données gardées en quittant le niveau (_lvlTempData).
+	begin(0x7F001000);
+	{
+		uint32 visited = _hasTempDataFlags;
+		if (_currentLevel >= 1 && _currentLevel <= 29)
+			visited |= 1u << (_currentLevel - 1);
+		u8(visited & 0xFF); u8((visited >> 8) & 0xFF); u8((visited >> 16) & 0xFF); u8(visited >> 24);
+		for (int l = 0; l < 29; l++) {
+			const bool cur = l + 1 == _currentLevel && _levelBlockProperties;
+			const uint16 *fl = (!cur && (_hasTempDataFlags & (1u << l)) && _lvlTempData[l]) ? _lvlTempData[l]->flags : nullptr;
+			for (int b = 0; b < 128; b++) {
+				uint8 v = 0;
+				for (int k = 0; k < 8; k++) {
+					const int i = b * 8 + k;
+					const uint16 f = cur ? _levelBlockProperties[i].flags : fl ? fl[i] : 0;
+					if (f & 7)
+						v |= 1 << k;
+				}
+				u8(v);
+			}
+		}
+	}
+	end();
+	// personnages prédéfinis (table de addCharacter) : nombre u8, puis id i16 + nom 11 octets + raceClassSex
+	begin(0x7F000800);
+	u8(_charDefaults ? _charDefaultsSize : 0);
+	for (int i = 0; _charDefaults && i < _charDefaultsSize; i++) {
+		u16((uint16)_charDefaults[i].id);
+		for (int k = 0; k < 11; k++) u8((uint8)_charDefaults[i].name[k]);
+		u8(_charDefaults[i].raceClassSex);
+	}
+	end();
+	// sauvegardes listées par la commande 14
+	begin(0x7F000700);
+	for (uint i = 0; i < _webSaveList.size(); i++) u8(_webSaveList[i]);
+	if (_webSaveList.empty()) { u8(0xFF); u8(0xFF); }	// pas encore listées
+	end();
+	// volumes du jeu (musique, effets, voix : 2 = coupé … 102), comme le menu « Contrôles audio »
+	begin(0x7F000600);
+	for (int v = 0; v < 3; v++) u8(getVolume((KyraEngine_v1::kVolumeEntry)v));
+	end();
+	// les 7 sorts de joueur (types 0 à 6), connus ou non : 7 entrées de 46 octets
+	// magie requise u16 × 4, vie requise u16 × 4, nom (30 octets, CP850)
+	begin(0x7F000480);
+	for (int t = 0; t < 7; t++) {
+		for (int l = 0; l < 4; l++) u16(_spellProperties ? _spellProperties[t].mpRequired[l] : 0);
+		for (int l = 0; l < 4; l++) u16(_spellProperties ? _spellProperties[t].hpRequired[l] : 0);
+		const char *n = _spellProperties ? getLangString(_spellProperties[t].spellNameCode) : "";
+		for (int k = 0; k < 30; k++) u8(n && k < (int)strlen(n) ? (uint8)n[k] : 0);
+	}
+	end();
+	begin(0x7F000000);
+	for (int t = 0; t < 5; t++) {
+		const int slot = _monsterProperties ? _monsterProperties[t].shapeIndex : -1;
+		const char *n = (slot >= 0 && slot < 3) ? _webMonsterShapeFile[slot] : "";
+		for (int k = 0; k < 13; k++) u8(k < (int)strlen(n) ? (uint8)n[k] : 0);
+	}
+	end();
+
+	// grille : 1024 cases de 10 octets (murs N E S O, objets posés, objets à dessiner, direction, drapeaux)
+	begin(0x3E713);
+	for (int i = 0; i < 1024; i++) {
+		const LevelBlockProperty &b = _levelBlockProperties[i];
+		for (int k = 0; k < 4; k++) u8(b.walls[k]);
+		u16(b.assignedObjects); u16(b.drawObjects); u8(b.direction); u8(b.flags);
+	}
+	end();
+
+	// objets : 400 entrées de 16 octets (le type, itemPropertyIndex, est à +12)
+	begin(0x31F79 - 12);
+	for (int i = 0; i < 400; i++) {
+		const LoLItem &t = _itemsInPlay[i];
+		u16(t.nextAssignedObject); u16(t.nextDrawObject); u8(t.flyingHeight); u16(t.block); u16(t.x); u16(t.y);
+		u8(t.level); u16(t.itemPropertyIndex); u16(t.shpCurFrame_flg);
+	}
+	end();
+
+	// monstres : 30 entrées de 46 octets (le champ x, à +7, est en 0x31871 pour la première)
+	begin(0x31871 - 7);
+	for (int i = 0; i < 30; i++) {
+		const LoLMonster &m = _monsters[i];
+		u16(m.nextAssignedObject); u16(m.nextDrawObject); u8(m.flyingHeight); u16(m.block); u16(m.x); u16(m.y);
+		u8(m.destDirection); u8(m.shiftStep); u16(m.destX); u16(m.destY); u8(m.hitOffsX); u8(m.hitOffsY);
+		u8(m.currentSubFrame); u8(m.mode); u8(m.fightCurTick); u8(m.id); u8(m.direction); u8(m.facing);
+		u16(m.flags); u16(m.damageReceived); u16(m.hitPoints); u8(m.speedTick); u8(m.type); u32(0);
+		u8(m.numDistAttacks); u8(m.curDistWeapon); u8(m.distAttackTick); u16(m.assignedItems);
+		for (int k = 0; k < 4; k++) u8(m.equipmentShapes[k]);
+	}
+	end();
+
+	// groupe : 4 fiches de 130 octets (le nom, à +2, est en 0x3389F pour la première)
+	begin(0x3389F - 2);
+	for (int i = 0; i < 4; i++) {
+		const LoLCharacter &c = _characters[i];
+		u16(c.flags); for (int k = 0; k < 11; k++) u8(c.name[k]); u8(c.raceClassSex); u16(c.id);
+		u8(c.curFaceFrame); u8(c.tempFaceFrame); u8(c.screamSfx); u32(0);
+		for (int k = 0; k < 8; k++) u16(c.itemsMight[k]);
+		for (int k = 0; k < 8; k++) u16(c.protectionAgainstItems[k]);
+		u16(c.itemProtection); u16(c.hitPointsCur); u16(c.hitPointsMax); u16(c.magicPointsCur); u16(c.magicPointsMax);
+		u8(c.field_41); u16(c.damageSuffered); u16(c.weaponHit); u16(c.totalMightModifier); u16(c.totalProtectionModifier);
+		u16(c.might); u16(c.protection); u16(c.nextAnimUpdateCountdown);
+		for (int k = 0; k < 11; k++) u16(c.items[k]);
+		for (int k = 0; k < 3; k++) u8(c.skillLevels[k]);
+		for (int k = 0; k < 3; k++) u8(c.skillModifiers[k]);
+		for (int k = 0; k < 3; k++) u32(c.experiencePts[k]);
+		for (int k = 0; k < 5; k++) u8(c.characterUpdateEvents[k]);
+		for (int k = 0; k < 5; k++) u8(c.characterUpdateDelay[k]);
+	}
+	end();
+
+	EM_ASM({ if (Module.lolState) Module.lolState(HEAPU8.slice($0, $0 + $1)); }, buf.data(), buf.size());
+#endif
+}
+
+// Version web : commandes d'inventaire de la page (Module.lolCmds : [op, a, b, id]…), exécutées
+// avec les fonctions du jeu (scripts des objets équipés, recalcul des caractéristiques, affichage).
+// Emplacements : 0..47 sac, 100 main, 200 + perso * 11 + emplacement d'équipement.
+// op 1 : déplacer a vers b (échange si b est occupé) ; op 2 : supprimer l'objet de a ;
+// op 3 : créer un objet de type a dans le sac ; op 4 : aller au niveau a, case b ;
+// op 5 : triches vie (a & 1) / magie (a & 2) infinies ; op 6 : ajouter a couronnes ;
+// op 7 / 8 (tests) : b points de dégâts / de magie dépensée au perso a. Résultat (Module.lolCmdDone(id, code)) :
+// 0 fait, 1 emplacement ou objet impossible, 2 sac plein, 3 emplacement vide.
+void LoLEngine::webRunCommands() {
+#ifdef __EMSCRIPTEN__
+	while (EM_ASM_INT({ return Module.lolCmds.length; })) {
+		const int op = EM_ASM_INT({ return Module.lolCmds[0][0]; });
+		const int a = EM_ASM_INT({ return Module.lolCmds[0][1]; });
+		const int b = EM_ASM_INT({ return Module.lolCmds[0][2]; });
+		EM_ASM({ Module.lolText = Module.lolCmds[0][4] || null; });
+		const int id = EM_ASM_INT({ return Module.lolCmds.shift()[3]; });
+		const int res = webInventoryCommand(op, a, b);
+		EM_ASM({ if (Module.lolCmdDone) Module.lolCmdDone($0, $1); }, id, res);
+	}
+#endif
+}
+
+Item LoLEngine::webItemAt(int loc) {
+	if (loc >= 0 && loc < 48)
+		return _inventory[loc];
+	if (loc == 100)
+		return _itemInHand;
+	if (loc >= 200 && loc < 244)
+		return _characters[(loc - 200) / 11].items[(loc - 200) % 11];
+	return 0;
+}
+
+void LoLEngine::webSetItemAt(int loc, Item item) {
+	if (loc >= 0 && loc < 48) {
+		_inventory[loc] = item;
+	} else if (loc == 100) {
+		setHandItem(item);
+	} else if (loc >= 200 && loc < 244) {
+		const int c = (loc - 200) / 11, k = (loc - 200) % 11;
+		const Item old = _characters[c].items[k];
+		_characters[c].items[k] = item;
+		recalcCharacterStats(c);
+		if (old)
+			runItemScript(c, old, 0x100, 0, 0);	// retiré (comme clickedCharInventorySlot)
+		if (item)
+			runItemScript(c, item, 0x80, 0, 0);	// équipé
+		gui_drawCharPortraitWithStats(c);
+		if ((_updateFlags & 2) && c == _selectedCharacter) {
+			gui_drawCharInventoryItem(k);
+			gui_changeCharacterStats(c);
+		}
+	}
+}
+
+int LoLEngine::webInventoryCommand(int op, int a, int b) {
+	auto validLoc = [&](int loc) {
+		return (loc >= 0 && loc < 48) || loc == 100 || (loc >= 200 && loc < 244 && (_characters[(loc - 200) / 11].flags & 1));
+	};
+	auto fits = [&](int loc, Item item) {	// l'objet peut-il aller à cet emplacement ?
+		if (!item || loc < 200)
+			return true;
+		return (_itemProperties[_itemsInPlay[item].itemPropertyIndex].type & (1 << ((loc - 200) % 11))) != 0;
+	};
+
+	if (op == 5) {	// triches : a = 1 vie infinie, 2 magie infinie (masque)
+		_webInfiniteHp = (a & 1) != 0;
+		_webInfiniteMp = (a & 2) != 0;
+		_webAutoAttack = (a & 4) != 0;
+		return 0;
+	}
+	if (op == 7 || op == 8) {	// tests : dégâts d'un monstre (7) ou magie dépensée (8) : b points au perso a
+		if (a < 0 || a > 3 || b <= 0 || !(_characters[a].flags & 1))
+			return 1;
+		if (op == 7)
+			inflictDamage(a, b, 0x8000, 0, 0);
+		else
+			setCharacterMagicOrHitPoints(a, 1, -b, 1);
+		return 0;
+	}
+	if (op == 10) {	// triche : monter d'un niveau le personnage a dans la compétence b (0 combat, 1 adresse, 2 magie)
+		// l'expérience manquante passe par increaseExperience : gains de vie / magie et message du jeu
+		if (a < 0 || a > 3 || b < 0 || b > 2 || !(_characters[a].flags & 1) || (_characters[a].flags & 8))
+			return 1;
+		LoLCharacter &c = _characters[a];
+		if (c.skillLevels[b] >= 10)
+			return 1;
+		const int32 need = _expRequirements[c.skillLevels[b]];
+		increaseExperience(a, b, need > c.experiencePts[b] ? need - c.experiencePts[b] : 0);
+		gui_drawCharPortraitWithStats(a);
+		return 0;
+	}
+	if (op == 18) {	// débloquer l'atlas (0x10, carte automatique), le livre de sorts (0x20, parchemin) et / ou la boussole (0x40) : drapeaux de _flagsTable[31]
+		// comme les scripts de l'histoire (drapeaux 252 et 254) ; le terrain de jeu est redessiné (livre, boussole)
+		if (!(a & 0x70) || (_updateFlags & 0x0F))
+			return 1;
+		_flagsTable[31] |= (a & 0x70);
+		if (a & 0x10)
+			updateAutoMap(_currentBlock);
+		gui_drawPlayField();
+		setPaletteBrightness(_screen->getPalette(0), _brightness, _lampEffect);
+		return 0;
+	}
+	if (op == 17)	// place a du groupe (1 ou 2) : personnage b de la table (0 = place vidée)
+		return webSetCharacter(a, b);
+	if (op == 16) {	// sauvegarder dans l'emplacement a (-1 : premier libre), nom = texte UTF-8 de la commande
+		// comme le menu « Sauvegarder » du jeu (clickedSavenameMenu) ; miniature générée par le moteur
+		Common::String desc;
+		const int len = EM_ASM_INT({ return Module.lolText ? Module.lolText.length : 0; });
+		for (int i = 0; i < len && i < 80; i++)
+			desc += (char)EM_ASM_INT({ return Module.lolText[$0]; }, i);
+		if (desc.empty())
+			desc = "Sauvegarde web";
+		int slot = a;
+		if (slot < 0) {
+			for (slot = 0; slot < 990; slot++) {
+				Common::InSaveFile *in = _saveFileMan->openForLoading(getSavegameFilename(slot));
+				if (!in)
+					break;
+				delete in;
+			}
+		}
+		if (slot < 0 || slot >= 990)
+			return 1;
+		updatePlayTimer();
+		if (saveGameStateIntern(slot, desc.c_str(), nullptr).getCode() != Common::kNoError)
+			return 5;
+		webInventoryCommand(14, 0, 0);	// liste à jour
+		return 0;
+	}
+	if (op == 14) {	// lister les sauvegardes (publiées en zone 0x7F000700 : nombre u16, puis n° u16 + nom 40 octets)
+		Common::SaveFileManager *sfm = _system->getSavefileManager();
+		Common::StringArray files = sfm->listSavefiles(_targetName + ".###");
+		Common::Array<int> slots;
+		for (const auto &f : files) {
+			const int slot = atoi(f.c_str() + f.size() - 3);
+			if (slot >= 0 && slot <= 999)
+				slots.push_back(slot);
+		}
+		Common::sort(slots.begin(), slots.end());
+		_webSaveList.clear();
+		_webSaveList.push_back(0); _webSaveList.push_back(0);
+		int n = 0;
+		for (int slot : slots) {
+			Common::InSaveFile *in = sfm->openForLoading(getSavegameFilename(_targetName, slot));
+			if (!in)
+				continue;
+			SaveHeader header;
+			if (readSaveHeader(in, header) == kRSHENoError && n < 200) {
+				_webSaveList.push_back(slot & 0xFF); _webSaveList.push_back(slot >> 8);
+				for (uint k = 0; k < 40; k++) _webSaveList.push_back(k < header.description.size() ? (byte)header.description[k] : 0);
+				n++;
+			}
+			delete in;
+		}
+		_webSaveList[0] = n & 0xFF; _webSaveList[1] = n >> 8;
+		return 0;
+	}
+	if (op == 15) {	// charger la sauvegarde a (comme le menu « Charger une partie » : _gameToLoad, lu par runLoop)
+		if (a < 0 || a > 999 || !saveFileLoadable(a))
+			return 1;
+		_gameToLoad = a;
+		return 0;
+	}
+	if (op == 13) {	// téléportation dans le niveau : case a, direction b (0-3, sinon inchangée)
+		// comme olol_setGlobalVar(0) des scripts (téléporteurs), puis la scène est redessinée
+		if (a < 0 || a > 1023 || (_updateFlags & 0x0F) || _weaponsDisabled || _activeMagicMenu != -1)
+			return 1;
+		for (int i = 0; i < 4; i++)	// case pleine (mur sur ses quatre faces) : refusée
+			if (!(_wllWallFlags[_levelBlockProperties[a].walls[i]] & 7))
+				break;
+			else if (i == 3)
+				return 1;
+		completeDoorOperations();
+		_currentBlock = a;
+		if (b >= 0 && b < 4)
+			_currentDirection = b;
+		calcCoordinates(_partyPosX, _partyPosY, _currentBlock, 0x80, 0x80);
+		updateAutoMap(_currentBlock);
+		gui_drawScene(0);
+		return 0;
+	}
+	if (op == 12) {	// volume a (0 musique, 1 effets, 2 voix) à b (2 = coupé … 102), comme le menu « Contrôles audio »
+		if (a < 0 || a > 2 || b < 2 || b > 102)
+			return 1;
+		if (a == 2)
+			snd_stopSpeech(0);
+		setVolume((KyraEngine_v1::kVolumeEntry)a, b);
+		ConfMan.flushToDisk();
+		return 0;
+	}
+	if (op == 11) {	// débloquer le sort de joueur a (0 à 6) ; b = personnage qui le « transmet » (animation)
+		// comme olol_addSpellToScroll (scripts du jeu : parchemins, maîtres de magie)
+		if (a < 0 || a > 6 || _activeMagicMenu != -1)
+			return 1;
+		for (int i = 0; i < 7; i++)
+			if (_availableSpells[i] == a)
+				return 6;	// déjà connu
+		if (b < 0 || b > 3 || !(_characters[b].flags & 1)) {
+			b = 0;
+			while (b < 3 && !(_characters[b].flags & 1))
+				b++;
+		}
+		addSpellToScroll(a, b);
+		if (_flagsTable[31] & 0x20) {	// parchemin des sorts affiché : le redessiner (page 2, puis écran)
+			const int cp = _screen->setCurPage(2);
+			gui_drawScroll();
+			_screen->setCurPage(cp);
+			_screen->copyRegion(12, 0, 12, 0, 87, 92, 2, 0, Screen::CR_NO_P_CHECK);
+			_screen->updateScreen();
+		}
+		return 0;
+	}
+	if (op == 9)	// lancer un sort : a = lanceur, b = type | niveau (0-3) << 8 | (cible + 1) << 12
+		return webCastSpell(a, b & 0xFF, (b >> 8) & 0xF, ((b >> 12) & 0xF) - 1);
+	if (op == 19) {	// attaque auto du personnage a : sort b (0-6, lancé au plus haut niveau possible), sinon arme
+		if (a < 0 || a > 3)
+			return 1;
+		_webAutoSpell[a] = (b >= 0 && b <= 6) ? b : 0xFF;
+		return 0;
+	}
+	if (op == 20) {	// cliquer le mur devant le groupe (levier, bouton, interrupteur de porte, décor à script), comme
+		// un clic sur la vue (clickedWall) ; la souris est placée au centre de la décoration du mur,
+		// que clickedShape vérifie. Réponse : 0 fait, 2 rien d'actionnable, 3 clic sans effet.
+		if (_updateFlags & 0x0F)
+			return 11;
+		if (_weaponsDisabled)
+			return 12;
+		if (_activeMagicMenu != -1)
+			return 13;
+		const int block = calcNewBlockPosition(_currentBlock, _currentDirection);
+		const int dir = _currentDirection ^ 2;
+		const uint8 wall = _levelBlockProperties[block].walls[dir];
+		const uint8 type = _specialWallTypes[wall];
+		if (!type || type > 5)	// 6 = niche : il faut un objet en main, déposé à la souris
+			return 2;
+		int mx = 112 + 88, my = 8 + 40;
+		for (int l = (int8)_wllShapeMap[wall]; l > 0; l = _levelDecorationProperties[l].next) {
+			const uint16 s = _levelDecorationProperties[l].shapeIndex[1];
+			if (s == 0xFFFF || !_levelDecorationShapes[s])
+				continue;
+			int w = _levelDecorationShapes[s][3];
+			const int h = _levelDecorationShapes[s][2];
+			if (_levelDecorationProperties[l].flags & 1)
+				w <<= 1;
+			mx = _levelDecorationProperties[l].shapeX[1] + _clickedShapeXOffs + w / 2;
+			my = _levelDecorationProperties[l].shapeY[1] + _clickedShapeYOffs + h / 2;
+			break;
+		}
