+// Version web : commandes d'inventaire de la page (Module.lolCmds : [op, a, b, id]…), exécutées
+// avec les fonctions du jeu (scripts des objets équipés, recalcul des caractéristiques, affichage).
+// Emplacements : 0..47 sac, 100 main, 200 + perso * 11 + emplacement d'équipement.
+// op 1 : déplacer a vers b (échange si b est occupé) ; op 2 : supprimer l'objet de a ;
+// op 3 : créer un objet de type a dans le sac ; op 4 : aller au niveau a, case b ;
+// op 5 : triches vie (a & 1) / magie (a & 2) infinies ; op 6 : ajouter a couronnes ;
+// op 7 / 8 (tests) : b points de dégâts / de magie dépensée au perso a. Résultat (Module.lolCmdDone(id, code)) :
+// 0 fait, 1 emplacement ou objet impossible, 2 sac plein, 3 emplacement vide.
+void LoLEngine::webRunCommands(bool all) {
+#ifdef __EMSCRIPTEN__
+	while (EM_ASM_INT({ return Module.lolCmds.length; })) {
+		const int op = EM_ASM_INT({ return Module.lolCmds[0][0]; });
+		if (!all) {	// hors de la boucle principale : seulement sac <-> main
+			const int a0 = EM_ASM_INT({ return Module.lolCmds[0][1]; }) & 0x3FFF, b0 = EM_ASM_INT({ return Module.lolCmds[0][2]; });
+			if (op != 1 || !((a0 < 48 && b0 == 100) || (a0 == 100 && b0 < 48)))
+				break;
+		}
+		const int a = EM_ASM_INT({ return Module.lolCmds[0][1]; });
+		const int b = EM_ASM_INT({ return Module.lolCmds[0][2]; });
+		EM_ASM({ Module.lolText = Module.lolCmds[0][4] || null; });
+		const int id = EM_ASM_INT({ return Module.lolCmds.shift()[3]; });
+		const int res = webInventoryCommand(op, a, b);
+		EM_ASM({ if (Module.lolCmdDone) Module.lolCmdDone($0, $1); }, id, res);
+	}
+#endif
+}
+
+// getLangString écrit dans l'un de 5 tampons tournants, que le jeu garde par pointeur (libellés des
+// boutons de dialogue Oui / Non…) : la publication lit le texte puis remet tampon et rotation en état
+// (sans cela, survoler « Non » pendant une vente affichait des noms de sorts sur les boutons)
+Common::String LoLEngine::webLangString(uint16 id) {
+	const int idx = _lastUsedStringBuffer;
+	char saved[sizeof(_stringBuffer[0])];
+	memcpy(saved, _stringBuffer[idx], sizeof(saved));
+	const char *str = getLangString(id);
+	const Common::String out(str ? str : "");
+	memcpy(_stringBuffer[idx], saved, sizeof(saved));
+	_lastUsedStringBuffer = idx;
+	return out;
+}
+
+bool LoLEngine::webSlotUsable(int c, int k) const {
+	return _charInvDefs[_charInvIndex[_characters[c].raceClassSex] * 22 + k * 2] != 0xFF;
+}
+
+// objet sous le curseur de la souris : case de la barre d'objets (en mode piles, seules les cases
+// ancrées), ou emplacement d'équipement de la fiche de personnage ouverte (_weaponsDisabled)
+Item LoLEngine::webHoverItem() {
+	if (_webInMenu || !_itemsInPlay || !_charInvDefs)
+		return 0;
+	const Common::Point p = getMousePos();
+	static const uint16 barX[] = { 0x6A, 0x7F, 0x94, 0xA9, 0xBE, 0xD3, 0xE8, 0xFD, 0x112 };
+	if (p.y >= 179 && p.y < 198) {
+		for (int i = 0; i < webBarCells(); i++) {
+			if (p.x < barX[i] || p.x >= barX[i] + 20)
+				continue;
+			const int slot = (_inventoryCurItem + i) % 48;
+			return (_webStackInv && !_webStackAnchor[slot]) ? 0 : _inventory[slot];
+		}
+	}
+	if (_weaponsDisabled && _selectedCharacter >= 0 && _selectedCharacter < 4) {
+		for (int k = 0; k < 11; k++) {
+			const uint8 *c = &_charInvDefs[_charInvIndex[_characters[_selectedCharacter].raceClassSex] * 22 + k * 2];
+			if (c[1] == 0xFF)
+				continue;
+			const int x = c[0] + 112, y = c[1];
+			const int x0 = k > 8 ? x - 4 : x, y0 = k > 8 ? y - 4 : y;
+			if (p.x >= x0 && p.x < x0 + 20 && p.y >= y0 && p.y < y0 + 18)
+				return _characters[_selectedCharacter].items[k];
+		}
+	}
+	return 0;
+}
+
+Item LoLEngine::webItemAt(int loc) {
+	if (loc >= 0 && loc < 48)
+		return _inventory[loc];
+	if (loc == 100)
+		return _itemInHand;
+	if (loc >= 200 && loc < 244)
+		return _characters[(loc - 200) / 11].items[(loc - 200) % 11];
+	return 0;
+}
+
+void LoLEngine::webSetItemAt(int loc, Item item) {
+	if (loc >= 0 && loc < 48) {
+		_inventory[loc] = item;
+	} else if (loc == 100) {
+		setHandItem(item);
+	} else if (loc >= 200 && loc < 244) {
+		const int c = (loc - 200) / 11, k = (loc - 200) % 11;
+		const Item old = _characters[c].items[k];
+		_characters[c].items[k] = item;
+		recalcCharacterStats(c);
+		if (old)
+			runItemScript(c, old, 0x100, 0, 0);	// retiré (comme clickedCharInventorySlot)
+		if (item)
+			runItemScript(c, item, 0x80, 0, 0);	// équipé
+		gui_drawCharPortraitWithStats(c);
+		if ((_updateFlags & 2) && c == _selectedCharacter) {
+			gui_drawCharInventoryItem(k);
+			gui_changeCharacterStats(c);
+		}
+	}
+}
+
+int LoLEngine::webInventoryCommand(int op, int a, int b) {
+	auto validLoc = [&](int loc) {
+		return (loc >= 0 && loc < 48) || loc == 100 || (loc >= 200 && loc < 244 && (_characters[(loc - 200) / 11].flags & 1));
+	};
+	// déplacement « strict » (page sans triches : bit 0x4000 de a) : en plus, emplacements que la race
+	// du personnage n'a pas (_charInvDefs à 0xFF, comme le jeu qui n'y affiche pas de case) refusés
+	bool strict = false;
+	if (op == 1 && (a & 0x4000)) {
+		strict = true;
+		a &= ~0x4000;
+	}
+	auto fits = [&](int loc, Item item) {	// l'objet peut-il aller à cet emplacement ?
+		if (!item || loc < 200)
+			return true;
+		if (strict && !webSlotUsable((loc - 200) / 11, (loc - 200) % 11))
+			return false;
+		return (_itemProperties[_itemsInPlay[item].itemPropertyIndex].type & (1 << ((loc - 200) % 11))) != 0;
+	};
+
+	if (op == 5) {	// triches : a = 1 vie infinie, 2 magie infinie (masque)
+		_webInfiniteHp = (a & 1) != 0;
+		_webInfiniteMp = (a & 2) != 0;
+		_webAutoAttack = (a & 4) != 0;
+		return 0;
+	}
+	if (op == 7 || op == 8) {	// tests : dégâts d'un monstre (7) ou magie dépensée (8) : b points au perso a
+		if (a < 0 || a > 3 || b <= 0 || !(_characters[a].flags & 1))
+			return 1;
+		if (op == 7)
+			inflictDamage(a, b, 0x8000, 0, 0);
+		else
+			setCharacterMagicOrHitPoints(a, 1, -b, 1);
+		return 0;
+	}
+	if (op == 10) {	// triche : monter d'un niveau le personnage a dans la compétence b (0 combat, 1 adresse, 2 magie)
+		// l'expérience manquante passe par increaseExperience : gains de vie / magie et message du jeu
+		if (a < 0 || a > 3 || b < 0 || b > 2 || !(_characters[a].flags & 1) || (_characters[a].flags & 8))
+			return 1;
+		LoLCharacter &c = _characters[a];
+		if (c.skillLevels[b] >= 10)
+			return 1;
+		const int32 need = _expRequirements[c.skillLevels[b]];
+		increaseExperience(a, b, need > c.experiencePts[b] ? need - c.experiencePts[b] : 0);
+		gui_drawCharPortraitWithStats(a);
+		return 0;
+	}
+	if (op == 18) {	// débloquer l'atlas (0x10, carte automatique), le livre de sorts (0x20, parchemin) et / ou la boussole (0x40) : drapeaux de _flagsTable[31]
+		// comme les scripts de l'histoire (drapeaux 252 et 254) ; le terrain de jeu est redessiné (livre, boussole)
+		if (!(a & 0x70) || (_updateFlags & 0x0F))
+			return 1;
+		_flagsTable[31] |= (a & 0x70);
+		if (a & 0x10)
+			updateAutoMap(_currentBlock);
+		gui_drawPlayField();
+		setPaletteBrightness(_screen->getPalette(0), _brightness, _lampEffect);
+		return 0;
+	}
+	if (op == 17)	// place a du groupe (1 ou 2) : personnage b de la table (0 = place vidée)
+		return webSetCharacter(a, b);
+	if (op == 16) {	// sauvegarder dans l'emplacement a (-1 : premier libre), nom = texte UTF-8 de la commande
+		// comme le menu « Sauvegarder » du jeu (clickedSavenameMenu) ; miniature générée par le moteur
+		Common::String desc;
+		const int len = EM_ASM_INT({ return Module.lolText ? Module.lolText.length : 0; });
+		for (int i = 0; i < len && i < 80; i++)
+			desc += (char)EM_ASM_INT({ return Module.lolText[$0]; }, i);
+		if (desc.empty())
+			desc = "Sauvegarde web";
+		int slot = a;
+		if (slot < 0) {
+			for (slot = 0; slot < 990; slot++) {
+				Common::InSaveFile *in = _saveFileMan->openForLoading(getSavegameFilename(slot));
+				if (!in)
+					break;
+				delete in;
+			}
+		}
+		if (slot < 0 || slot >= 990)
+			return 1;
+		updatePlayTimer();
+		if (saveGameStateIntern(slot, desc.c_str(), nullptr).getCode() != Common::kNoError)
+			return 5;
+		webInventoryCommand(14, 0, 0);	// liste à jour
+		return 0;
+	}
+	if (op == 14) {	// lister les sauvegardes (publiées en zone 0x7F000700 : nombre u16, puis n° u16 + nom 40 octets)
+		Common::SaveFileManager *sfm = _system->getSavefileManager();
+		Common::StringArray files = sfm->listSavefiles(_targetName + ".###");
+		Common::Array<int> slots;
+		for (const auto &f : files) {
+			const int slot = atoi(f.c_str() + f.size() - 3);
+			if (slot >= 0 && slot <= 999)
+				slots.push_back(slot);
+		}
+		Common::sort(slots.begin(), slots.end());
+		_webSaveList.clear();
+		_webSaveList.push_back(0); _webSaveList.push_back(0);
+		int n = 0;
+		for (int slot : slots) {
+			Common::InSaveFile *in = sfm->openForLoading(getSavegameFilename(_targetName, slot));
+			if (!in)
+				continue;
+			SaveHeader header;
+			if (readSaveHeader(in, header) == kRSHENoError && n < 200) {
+				_webSaveList.push_back(slot & 0xFF); _webSaveList.push_back(slot >> 8);
+				for (uint k = 0; k < 40; k++) _webSaveList.push_back(k < header.description.size() ? (byte)header.description[k] : 0);
+				n++;
+			}
+			delete in;
+		}
+		_webSaveList[0] = n & 0xFF; _webSaveList[1] = n >> 8;
+		return 0;
+	}
+	if (op == 15) {	// charger la sauvegarde a (comme le menu « Charger une partie » : _gameToLoad, lu par runLoop)
+		if (a < 0 || a > 999 || !saveFileLoadable(a))
+			return 1;
+		_gameToLoad = a;
+		return 0;
+	}
+	if (op == 13) {	// téléportation dans le niveau : case a, direction b (0-3, sinon inchangée)
+		// comme olol_setGlobalVar(0) des scripts (téléporteurs), puis la scène est redessinée
+		if (a < 0 || a > 1023 || (_updateFlags & 0x0F) || _weaponsDisabled || _activeMagicMenu != -1)
+			return 1;
+		for (int i = 0; i < 4; i++)	// case pleine (mur sur ses quatre faces) : refusée
+			if (!(_wllWallFlags[_levelBlockProperties[a].walls[i]] & 7))
+				break;
+			else if (i == 3)
+				return 1;
+		completeDoorOperations();
+		_currentBlock = a;
+		if (b >= 0 && b < 4)
+			_currentDirection = b;
+		calcCoordinates(_partyPosX, _partyPosY, _currentBlock, 0x80, 0x80);
+		updateAutoMap(_currentBlock);
+		gui_drawScene(0);
+		return 0;
+	}
+	if (op == 12) {	// volume a (0 musique, 1 effets, 2 voix) à b (2 = coupé … 102), comme le menu « Contrôles audio »
+		if (a < 0 || a > 2 || b < 2 || b > 102)
+			return 1;
+		if (a == 2)
+			snd_stopSpeech(0);
+		setVolume((KyraEngine_v1::kVolumeEntry)a, b);
+		ConfMan.flushToDisk();
+		return 0;
+	}
+	if (op == 11) {	// débloquer le sort de joueur a (0 à 6) ; b = personnage qui le « transmet » (animation)
+		// comme olol_addSpellToScroll (scripts du jeu : parchemins, maîtres de magie)
+		if (a < 0 || a > 6 || _activeMagicMenu != -1)
+			return 1;
+		for (int i = 0; i < 7; i++)
+			if (_availableSpells[i] == a)
+				return 6;	// déjà connu
+		if (b < 0 || b > 3 || !(_characters[b].flags & 1)) {
+			b = 0;
+			while (b < 3 && !(_characters[b].flags & 1))
+				b++;
+		}
+		addSpellToScroll(a, b);
+		if (_flagsTable[31] & 0x20) {	// parchemin des sorts affiché : le redessiner (page 2, puis écran)
+			const int cp = _screen->setCurPage(2);
+			gui_drawScroll();
+			_screen->setCurPage(cp);
+			_screen->copyRegion(12, 0, 12, 0, 87, 92, 2, 0, Screen::CR_NO_P_CHECK);
+			_screen->updateScreen();
+		}
+		return 0;
+	}
+	if (op == 9)	// lancer un sort : a = lanceur, b = type | niveau (0-3) << 8 | (cible + 1) << 12
+		return webCastSpell(a, b & 0xFF, (b >> 8) & 0xF, ((b >> 12) & 0xF) - 1);
+	if (op == 19) {	// attaque auto du personnage a : sort b (0-6, lancé au plus haut niveau possible), sinon arme
+		if (a < 0 || a > 3)
+			return 1;
+		_webAutoSpell[a] = (b >= 0 && b <= 6) ? b : 0xFF;
+		return 0;
+	}
+	if (op == 20) {	// cliquer le mur devant le groupe (levier, bouton, interrupteur de porte, décor à script), comme
+		// un clic sur la vue (clickedWall) ; la souris est placée au centre de la décoration du mur,
+		// que clickedShape vérifie. Réponse : 0 fait, 2 rien d'actionnable, 3 clic sans effet.
+		if (_updateFlags & 0x0F)
+			return 11;
+		if (_weaponsDisabled)
+			return 12;
+		if (_activeMagicMenu != -1)
+			return 13;
+		const int block = calcNewBlockPosition(_currentBlock, _currentDirection);
+		const int dir = _currentDirection ^ 2;
+		const uint8 wall = _levelBlockProperties[block].walls[dir];
+		const uint8 type = _specialWallTypes[wall];
+		if (!type || type > 5)	// 6 = niche : il faut un objet en main, déposé à la souris
+			return 2;
+		int mx = 112 + 88, my = 8 + 40;
+		for (int l = (int8)_wllShapeMap[wall]; l > 0; l = _levelDecorationProperties[l].next) {
+			const uint16 s = _levelDecorationProperties[l].shapeIndex[1];
+			if (s == 0xFFFF || !_levelDecorationShapes[s])
+				continue;
+			int w = _levelDecorationShapes[s][3];
+			const int h = _levelDecorationShapes[s][2];
+			if (_levelDecorationProperties[l].flags & 1)
+				w <<= 1;
+			mx = _levelDecorationProperties[l].shapeX[1] + _clickedShapeXOffs + w / 2;
+			my = _levelDecorationProperties[l].shapeY[1] + _clickedShapeYOffs + h / 2;
+			break;
+		}
+		// bouton (1) et porte (5) lancent leur script avec 0x40 écrit en dur : le test de position
+		// (clickedShape, actif seulement si _clickedSpecialFlag vaut 0x40) est inutile ; les
+		// leviers (2, 3) et les scripts seuls (4) passent _clickedSpecialFlag au script : gardé
+		const int ox = _mouseX, oy = _mouseY, of = _clickedSpecialFlag;
+		_mouseX = mx;
+		_mouseY = my;
+		if (type == 1 || type == 5)
+			_clickedSpecialFlag = 0;
+		const int res = clickedWall(nullptr);
+		_clickedSpecialFlag = of;
+		_mouseX = ox;
+		_mouseY = oy;
+		return res ? 0 : 3;
+	}
+	if (op == 21) {	// utiliser l'objet de la case a du sac (0-47) sur le personnage b, comme un clic droit sur
+		// son portrait avec l'objet en main (clickedPortraitEtcRight) : script de l'objet (0x400) et
+		// script du niveau. L'objet tenu avant est rendu à la main ; ce qui reste en main après le
+		// script (objet non consommé, flacon vide…) retourne dans le sac.
+		// Réponse : 0 utilisé, 1 invalide, 3 case vide, 4 objet non utilisable, 5 personnage hors de
+		// combat, 11 dialogue ou scène, 13 menu de magie ouvert.
+		if (a < 0 || a >= 48 || b < 0 || b > 3 || !(_characters[b].flags & 1))
+			return 1;
+		if (_updateFlags & 0x0D)
+			return 11;
+		if (_activeMagicMenu != -1)
+			return 13;
+		const Item item = _inventory[a];
+		if (!item)
+			return 3;
+		const int flg = _itemProperties[_itemsInPlay[item].itemPropertyIndex].flags;
+		if (!(flg & 1))
+			return 4;
+		if ((_characters[b].flags & 8) && !(flg & 0x20))
+			return 5;
+		const Item held = _itemInHand;
+		_inventory[a] = 0;
+		setHandItem(item);
+		runItemScript(b, _itemInHand, 0x400, 0, 0);
+		runLevelScriptCustom(_currentBlock, 0x400, b, _itemInHand, 0, 0);
+		const Item left = _itemInHand;
+		setHandItem(held);
+		if (left) {
+			if (!_inventory[a])
+				_inventory[a] = left;
+			else if (!addItemToInventory(left))
+				setHandItem(left);
+		}
+		gui_drawInventory();
+		gui_drawCharPortraitWithStats(b);
+		return 0;
+	}
+	if (op == 22) {	// objet en main : a = 0 le lancer devant le groupe, comme un clic dans le haut de la vue
+		// (clickedSceneThrowItem : vers un monstre) ; a = 1 à 4 le poser, comme un clic sur le sol
+		// (clickedSceneDropItem, bouton a − 1 : 0/1 case du groupe à gauche/droite, 2/3 case devant).
+		// Réponse : 0 fait, 1 rien en main, 2 impossible (mur devant…), 11 dialogue ou scène.
+		if (!_itemInHand)
+			return 1;
+		if (_updateFlags & 1)
+			return 11;
+		const Item before = _itemInHand;
+		Button btn;
+		btn.arg = a > 0 ? a - 1 : 0;
+		if (a == 0)
+			clickedSceneThrowItem(&btn);
+		else if (a >= 1 && a <= 4)
+			clickedSceneDropItem(&btn);
+		else
+			return 1;
+		return _itemInHand == before ? 2 : 0;
+	}
+	if (op == 23) {	// objet en main utilisé sur le personnage a, comme un clic droit sur son portrait
+		// (clickedPortraitEtcRight). Réponse : 0 fait, 1 rien en main ou personnage absent, 11 dialogue.
+		if (!_itemInHand || a < 0 || a > 3 || !(_characters[a].flags & 1))
+			return 1;
+		if (_updateFlags & 0x0D)
+			return 11;
+		Button btn;
+		btn.arg = a;
+		clickedPortraitEtcRight(&btn);
+		gui_drawCharPortraitWithStats(a);
+		return 0;
+	}
+	if (op == 24) {	// ramasser au sol un objet de type b sur la case a (case du groupe ou case devant lui, comme
+		// clickedScenePickupItem) : pris en main si elle est libre, sinon rangé dans le sac.
+		// Réponse : 6 fait (en main), 0 fait (sac), 1 case hors de portée, 2 mur devant,
+		// 3 pas d'objet de ce type, 11 dialogue ou scène.
+		if (_updateFlags & 1)
+			return 11;
+		const int front = calcNewBlockPosition(_currentBlock, _currentDirection);
+		if (a != _currentBlock && a != front)
+			return 1;
+		if (a == front && (_wllWallFlags[_levelBlockProperties[front].walls[_currentDirection ^ 2]] & 2))
+			return 2;
+		Item found = 0;
+		for (uint16 o = _levelBlockProperties[a].drawObjects; o; ) {
+			if (!(o & 0x8000) && _itemsInPlay[o].itemPropertyIndex == b) {
+				found = o;
+				break;
+			}
+			o = findObject(o)->nextDrawObject;
+		}
+		if (!found)
+			return 3;
+		removeLevelItem(found, a);
+		_sceneUpdateRequired = true;
+		if (!_itemInHand) {	// main libre : pris en main, comme dans le jeu
+			setHandItem(found);
+			return 6;
+		}
+		if (addItemToInventory(found)) {
+			gui_drawInventory();
+			return 0;
+		}
+		setItemPosition(found, _partyPosX, _partyPosY, 0, 1);	// ni sac ni main : reposé aux pieds du groupe
+		return 2;
+	}
+	if (op == 25) {	// fiche de personnage du jeu : a = 0-3 l'ouvrir sur ce personnage (clic sur son portrait,
+		// clickedPortraitLeft), a = -1 la fermer (bouton de sortie, clickedExitCharInventory).
+		// Réponse : 0 fait, 1 personnage absent, 11 dialogue ou scène.
+		Button btn;
+		if (a < 0) {
+			if (_weaponsDisabled)
+				clickedExitCharInventory(&btn);
+			return 0;
+		}
+		if (a > 3 || !(_characters[a].flags & 1))
+			return 1;
+		if ((_updateFlags & 1) || _activeMagicMenu != -1)
+			return 11;
+		btn.arg = a;
+		clickedPortraitLeft(&btn);
+		return 0;
+	}
+	if (op == 27) {	// ranger l'objet en main dans le sac (sur sa pile en mode piles, sinon emplacement libre),
+		// comme un objet ramassé : addItemToInventory, la barre défile jusqu'à lui
+		if (!_itemInHand)
+			return 3;
+		return webStoreHand() ? 0 : 2;
+	}
+	if (op == 26) {	// barre d'objets du jeu par piles (a = 1) ou par emplacements (a = 0)
+		if ((a != 0) != _webStackInv) {
+			_webStackInv = a != 0;
+			webStackReveal();
+			gui_drawInventory();
+		}
+		return 0;
+	}
+	if (op == 6) {	// ajouter a couronnes
+		if (a <= 0)
+			return 1;
+		giveCredits(a, 1);
+		return 0;
+	}
+	if (op == 4) {	// aller au niveau a, case b (comme olol_loadNewLevel)
+		if (a < 1 || a > 29 || b < 0 || b > 1023)
+			return 1;
+		_screen->fadeClearSceneWindow(10);
+		_screen->fillRect(112, 0, 288, 120, 0);
+		disableSysTimer(2);
+		for (int i = 0; i < 8; i++) {
+			if (!_flyingObjects[i].enable || _flyingObjects[i].objectType)
+				continue;
+			endObjectFlight(&_flyingObjects[i], _flyingObjects[i].x, _flyingObjects[i].y, 1);
+		}
+		completeDoorOperations();
+		generateTempData();
+		_currentBlock = b;
+		_currentDirection = 0;
+		calcCoordinates(_partyPosX, _partyPosY, _currentBlock, 0x80, 0x80);
+		loadLevel(a);
+		enableSysTimer(2);
+		return 0;
+	}
+	if (op == 3) {
+		if (a <= 0 || a >= _webNumItemProperties)
+			return 1;
+		const Item item = makeItem(a, 0, 0);
+		if (!item)
+			return 1;
+		if (!addItemToInventory(item)) {
+			deleteItem(item);
+			return 2;
+		}
+		gui_drawInventory();
+		return 0;
+	}
+	if (!validLoc(a))
+		return 1;
+	const Item ia = webItemAt(a);
+	if (!ia)
+		return 3;
+	if (op == 2) {
+		webSetItemAt(a, 0);
+		deleteItem(ia);
+		gui_drawInventory();
+		return 0;
+	}
+	if (op != 1 || !validLoc(b) || a == b)
+		return 1;
+	const Item ib = webItemAt(b);
+	if (!fits(b, ia) || !fits(a, ib))
+		return 1;
+	// retirer d'abord (scripts « retiré »), puis poser
+	webSetItemAt(a, 0);
+	webSetItemAt(b, 0);
+	webSetItemAt(b, ia);
+	webSetItemAt(a, ib);
+	gui_drawInventory();
+	return 0;
+}
