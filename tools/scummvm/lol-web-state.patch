+// Version web (emscripten) : publie l'état du jeu pour la mini-carte de la page, sous la forme
+// de zones d'octets placées aux adresses physiques du jeu DOS (docs/reverse-engineering.md, § 12)
+// et rangées comme dans le jeu DOS (structures compactées, pointeurs sur 4 octets mis à 0).
+// La page répond avec ces zones sur le canal « lol-mem » comme l'émulateur DOSBox.
+// Format : (adresse u32, longueur u32, octets)…, petit-boutiste.
+void LoLEngine::webPublishState(bool mainLoop) {
+#ifdef __EMSCRIPTEN__
+	static uint32 lastTime = 0;
+	static Common::Array<byte> buf;
+	const uint32 now = _system->getMillis();
+	if (mainLoop) {
+		_webLoopCount++;
+		_webLoadingLevel = false;
+	}
+	// hors de la boucle principale (dialogues, scènes de lieu comme une boutique) : seuls les
+	// déplacements d'objets sac <-> main (commande 1) sont exécutés, pour vendre en montrant un objet
+	const bool changed = EM_ASM_INT({ return Module.lolCmds && Module.lolCmds.length ? 1 : 0; });
+	if (changed)
+		webRunCommands(mainLoop);
+	// attaque automatique : chaque personnage prêt frappe le monstre le plus proche de la case
+	// devant le groupe, comme un clic sur son arme (clickedAttackButton). Monstres paisibles
+	// (mode 1, ex. gardes de Gladstone) et mourants (mode >= 13) épargnés.
+	// Personnage réglé sur un sort (_webAutoSpell) : sort lancé au plus haut niveau que sa magie et
+	// sa vie permettent, sur un monstre hostile jusqu'à 3 cases devant (getSpellTargetBlock) ;
+	// pas assez de magie : arme.
+	if (mainLoop && _webAutoAttack && !(_updateFlags & 0x0F) && !_weaponsDisabled && _activeMagicMenu == -1 && now - _webAutoAttackTime >= 200) {
+		_webAutoAttackTime = now;
+		auto hostileAt = [&](uint16 block) {
+			if (block > 1023)
+				return false;
+			int o = _levelBlockProperties[block].assignedObjects;
+			while (o & 0x8000) {
+				const LoLMonster *m = &_monsters[o & 0x7FFF];
+				if (m->mode < 13 && m->mode != 1)
+					return true;
+				o = m->nextAssignedObject;
+			}
+			return false;
+		};
+		for (int i = 0; i < 4; i++) {
+			if (!(_characters[i].flags & 1) || (_characters[i].flags & 0x314C))
+				continue;
+			const int sp = _webAutoSpell[i];
+			if (sp != 0xFF && _spellProperties) {
+				uint16 tb = 0xFFFF;
+				getSpellTargetBlock(_currentBlock, _currentDirection, 3, tb);
+				if (tb != 0xFFFF && hostileAt(tb)) {
+					int lvl = -1;
+					for (int l = 3; l >= 0 && lvl < 0; l--)
+						if (_spellProperties[sp].mpRequired[l] <= _characters[i].magicPointsCur && _spellProperties[sp].hpRequired[l] < _characters[i].hitPointsCur)
+							lvl = l;
+					if (lvl >= 0 && webCastSpell(i, sp, lvl, -1) == 0)
+						continue;
+				}
+			}
+			if (_characters[i].flags & 0x314C)
+				continue;
+			const uint16 t = getNearestMonsterFromCharacter(i);
+			if (t == 0xFFFF || !(t & 0x8000) || _monsters[t & 0x7FFF].mode == 1)
+				continue;
+			Button b;
+			b.arg = i;
+			clickedAttackButton(&b);
+		}
+	}
+	for (int i = 0; i < 4 && mainLoop; i++) {	// triches : remettre au maximum (ce qui a été perdu avant l'activation)
+		LoLCharacter &c = _characters[i];
+		if (!(c.flags & 1) || (c.flags & 8))
+			continue;
+		if (_webInfiniteHp && c.hitPointsCur < (int)c.hitPointsMax)
+			setCharacterMagicOrHitPoints(i, 0, c.hitPointsMax, 0);
+		if (_webInfiniteMp && c.magicPointsCur < (int)c.magicPointsMax)
+			setCharacterMagicOrHitPoints(i, 1, c.magicPointsMax, 0);
+	}
+	if (now - lastTime < (mainLoop ? 150u : 100u) && !changed)
+		return;
+	lastTime = now;
+	buf.clear();
+	uint32 start = 0;
+	auto u8 = [&](uint32 v) { buf.push_back(v & 0xFF); };
+	auto u16 = [&](uint32 v) { u8(v); u8(v >> 8); };
+	auto u32 = [&](uint32 v) { u16(v); u16(v >> 16); };
+	auto begin = [&](uint32 addr) { u32(addr); start = buf.size(); u32(0); };
+	auto end = [&]() { const uint32 n = buf.size() - start - 4; for (int i = 0; i < 4; i++) buf[start + i] = (n >> (8 * i)) & 0xFF; };
+
+	begin(0x3E4E0); u16(_currentBlock); end();
+	begin(0x3E4EF); u16(_currentDirection); end();
+	// niveau en cours (u8) : les niveaux 2 et 3 (forêts du Nord et du Sud) ont la même carte à
+	// 4 faces près, la page ne peut pas les distinguer par la grille
+	begin(0x7F000A00); u8(_currentLevel); end();
+	// fiche de personnage du jeu : ouverte (u8), personnage affiché (u8)
+	// (_weaponsDisabled : mis par clickedPortraitLeft à l'ouverture, remis à zéro par clickedExitCharInventory)
+	// + réplique parlée en cours (voix jouée ou en file) : dialogue d'accueil d'une boutique… (u8)
+	begin(0x7F000D00); u8(_weaponsDisabled ? 1 : 0); u8(_selectedCharacter);
+	u8((_sound->voiceIsPlaying(&_speechHandle) || _speechList.begin() != _speechList.end()) ? 1 : 0); end();
+	// emplacements d'équipement utilisables par la race de chaque personnage (4 × u16, bit k = emplacement k)
+	begin(0x7F000C00);
+	for (int c = 0; c < 4; c++) {
+		uint16 m = 0;
+		if (_characters[c].flags & 1)
+			for (int k = 0; k < 11; k++)
+				if (webSlotUsable(c, k))
+					m |= 1 << k;
+		u16(m);
+	}
+	end();
+	// dernière réplique : numéro u16, locuteur s8 (0-3 place dans le groupe, -1 hors du groupe,
+	// -2 sans locuteur), longueur u16, texte (codage du jeu, 400 octets au plus)
+	begin(0x7F000B00);
+	{
+		const uint n = MIN<uint>(_webDialogue.size(), 400);
+		u16(_webDialogueSeq); u8((uint8)(int8)_webDialogueSpeaker); u16(n);
+		for (uint k = 0; k < n; k++)
+			u8((uint8)_webDialogue[k]);
+	}
+	end();
+	begin(0x5D6B5); u8(_specialSceneFlag ? 1 : 5); end();
+	begin(0x3E6F0); u16(_credits); end();
+	begin(0x3E558); u16(_itemInHand); end();
+	begin(0x3E4F6); for (int i = 0; i < 48; i++) u16(_inventory[i]); end();
+	begin(0x3E55C); for (int i = 0; i < 128; i++) u8(i < (int)sizeof(_flagsTable) ? _flagsTable[i] : 0); end();
+	begin(0x30270); for (int i = 0; i < 11; i++) u32(_expRequirements ? _expRequirements[i] : 0); end();
+	// sprites des monstres (zone propre à la version web, hors de la mémoire DOS) : pour chacun des
+	// 5 types de monstres, nom (13 octets) du fichier chargé dans son emplacement (shapeIndex)
+	// affichage (zone propre à la version web) : scène spéciale, _updateFlags, fenêtre de séquence
+	// (x1, y1, x2, y2), menu ouvert, tours de la boucle principale (s'arrêtent pendant dialogues,
+	// séquences et cinématiques, qui ont leurs propres boucles)
+	begin(0x7F000100);
+	u8(_specialSceneFlag ? 1 : 0); u16(_updateFlags);
+	u16(_seqWindowX1); u16(_seqWindowY1); u16(_seqWindowX2); u16(_seqWindowY2);
+	u8(_webInMenu ? 1 : 0); u32(_webLoopCount); u8(_webLoadingLevel ? 1 : 0); u8(_webCasting ? 1 : 0);
+	u8(_webSceneArt ? 1 : 0);
+	{	// objet sous le curseur : type + 1 (0 = aucun), nombre d'exemplaires de sa pile (mode piles)
+		const Item h = webHoverItem();
+		u16(h ? _itemsInPlay[h].itemPropertyIndex + 1 : 0);
+		int n = 0;
+		if (h && _webStackInv) {
+			for (int i = 0; i < 48; i++)
+				n += webSameStack(_inventory[i], h) ? 1 : 0;
+		}
+		u8(n);
+	}
+	u8(_webWallSeq); u16(_webWallBlock); u8(_webWallFace); u8(_webWallHandEmpty ? 1 : 0);	// dernier clic sur un mur
+	end();
+	// image de chaque monstre telle que le jeu la dessine vu du groupe (drawMonster), 4 octets :
+	// numéro d'image (0-15, 255 = aucune) ; 1 = image retournée horizontalement ; giclée de coup
+	// reçu (image 6 de GAMESHP.SHP) : réduction 1-4 (0 = aucune) ; couleur 0-3 (drapeaux & 0xC000)
+	begin(0x7F000200);
+	for (int i = 0; i < 30; i++) {
+		LoLMonster *m = &_monsters[i];
+		int frm = -1, flip = 0, blood = 0, bloodType = 0;
+		if (m->properties && _monsterDirFlags && m->block) {
+			const int16 flg = _monsterDirFlags[(_currentDirection << 2) + (m->facing & 3)];
+			frm = getMonsterCurFrame(m, flg & 0xFFEF);
+			flip = (flg & 0x10) ? 1 : 0;
+			if (m->damageReceived && frm >= 0) {
+				const int dmg = m->damageReceived & 0x7FFF;
+				int amount = (m->mode == 13) ? (m->fightCurTick << 1) : (dmg ? m->properties->hitPoints / dmg : 4);
+				blood = CLIP(amount, 1, 4);
+				bloodType = (m->properties->flags & 0xC000) >> 14;
+			}
+		}
+		u8(frm < 0 || frm > 15 ? 255 : frm); u8(flip); u8(blood); u8(bloodType);
+	}
+	end();
+	// sorts connus du groupe (version web) : 7 entrées de 48 octets
+	// type (i8, -1 = aucun), 0, magie requise u16 × 4 niveaux, vie requise u16 × 4, nom (30 octets, CP850)
+	begin(0x7F000300);
+	for (int i = 0; i < 7; i++) {
+		const int t = _availableSpells[i];
+		u8(t < 0 ? 0xFF : t); u8(0);
+		for (int l = 0; l < 4; l++) u16(t < 0 ? 0 : _spellProperties[t].mpRequired[l]);
+		for (int l = 0; l < 4; l++) u16(t < 0 ? 0 : _spellProperties[t].hpRequired[l]);
+		const Common::String ns = t < 0 ? Common::String() : webLangString(_spellProperties[t].spellNameCode);
+		const char *n = ns.c_str();
+		for (int k = 0; k < 30; k++) u8(k < (int)strlen(n) ? (uint8)n[k] : 0);
+	}
+	end();
+	// points de vie maximum des 5 types de monstres du niveau (u16 ; type = champ +32 du monstre),
+	// puis leurs drapeaux (u16 ; 0x800 = translucide, 0x200 = image retournée, 0xC000 = sang)
+	begin(0x7F000900);
+	for (int t = 0; t < 5; t++) u16(_monsterProperties ? _monsterProperties[t].hitPoints : 0);
+	for (int t = 0; t < 5; t++) u16(_monsterProperties ? _monsterProperties[t].flags : 0);
+	end();
+	// carte automatique du jeu, tous niveaux : niveaux visités (u32, bit n-1 = niveau n ; _hasTempDataFlags,
+	// plus le niveau en cours), puis 29 × 128 octets (bit i&7 de l'octet i>>3 : case i marquée, flags & 7).
+	// Niveau en cours : grille vivante ; autres : données gardées en quittant le niveau (_lvlTempData).
+	begin(0x7F001000);
+	{
+		uint32 visited = _hasTempDataFlags;
+		if (_currentLevel >= 1 && _currentLevel <= 29)
+			visited |= 1u << (_currentLevel - 1);
+		u8(visited & 0xFF); u8((visited >> 8) & 0xFF); u8((visited >> 16) & 0xFF); u8(visited >> 24);
+		for (int l = 0; l < 29; l++) {
+			const bool cur = l + 1 == _currentLevel && _levelBlockProperties;
+			const uint16 *fl = (!cur && (_hasTempDataFlags & (1u << l)) && _lvlTempData[l]) ? _lvlTempData[l]->flags : nullptr;
+			for (int b = 0; b < 128; b++) {
+				uint8 v = 0;
+				for (int k = 0; k < 8; k++) {
+					const int i = b * 8 + k;
+					const uint16 f = cur ? _levelBlockProperties[i].flags : fl ? fl[i] : 0;
+					if (f & 7)
+						v |= 1 << k;
+				}
+				u8(v);
+			}
+		}
+	}
+	end();
+	// personnages prédéfinis (table de addCharacter) : nombre u8, puis id i16 + nom 11 octets + raceClassSex
+	begin(0x7F000800);
+	u8(_charDefaults ? _charDefaultsSize : 0);
+	for (int i = 0; _charDefaults && i < _charDefaultsSize; i++) {
+		u16((uint16)_charDefaults[i].id);
+		for (int k = 0; k < 11; k++) u8((uint8)_charDefaults[i].name[k]);
+		u8(_charDefaults[i].raceClassSex);
+	}
+	end();
+	// sauvegardes listées par la commande 14
+	begin(0x7F000700);
+	for (uint i = 0; i < _webSaveList.size(); i++) u8(_webSaveList[i]);
+	if (_webSaveList.empty()) { u8(0xFF); u8(0xFF); }	// pas encore listées
+	end();
+	// volumes du jeu (musique, effets, voix : 2 = coupé … 102), comme le menu « Contrôles audio »
+	begin(0x7F000600);
+	for (int v = 0; v < 3; v++) u8(getVolume((KyraEngine_v1::kVolumeEntry)v));
+	end();
+	// les 7 sorts de joueur (types 0 à 6), connus ou non : 7 entrées de 46 octets
+	// magie requise u16 × 4, vie requise u16 × 4, nom (30 octets, CP850)
+	begin(0x7F000480);
+	for (int t = 0; t < 7; t++) {
+		for (int l = 0; l < 4; l++) u16(_spellProperties ? _spellProperties[t].mpRequired[l] : 0);
+		for (int l = 0; l < 4; l++) u16(_spellProperties ? _spellProperties[t].hpRequired[l] : 0);
+		const Common::String ns = _spellProperties ? webLangString(_spellProperties[t].spellNameCode) : Common::String();
+		const char *n = ns.c_str();
+		for (int k = 0; k < 30; k++) u8(k < (int)strlen(n) ? (uint8)n[k] : 0);
+	}
+	end();
+	begin(0x7F000000);
+	for (int t = 0; t < 5; t++) {
+		const int slot = _monsterProperties ? _monsterProperties[t].shapeIndex : -1;
+		const char *n = (slot >= 0 && slot < 3) ? _webMonsterShapeFile[slot] : "";
+		for (int k = 0; k < 13; k++) u8(k < (int)strlen(n) ? (uint8)n[k] : 0);
+	}
+	end();
+
+	// grille : 1024 cases de 10 octets (murs N E S O, objets posés, objets à dessiner, direction, drapeaux)
+	begin(0x3E713);
+	for (int i = 0; i < 1024; i++) {
+		const LevelBlockProperty &b = _levelBlockProperties[i];
+		for (int k = 0; k < 4; k++) u8(b.walls[k]);
+		u16(b.assignedObjects); u16(b.drawObjects); u8(b.direction); u8(b.flags);
+	}
+	end();
+
+	// objets : 400 entrées de 16 octets (le type, itemPropertyIndex, est à +12)
+	begin(0x31F79 - 12);
+	for (int i = 0; i < 400; i++) {
+		const LoLItem &t = _itemsInPlay[i];
+		u16(t.nextAssignedObject); u16(t.nextDrawObject); u8(t.flyingHeight); u16(t.block); u16(t.x); u16(t.y);
+		u8(t.level); u16(t.itemPropertyIndex); u16(t.shpCurFrame_flg);
+	}
+	end();
+
+	// monstres : 30 entrées de 46 octets (le champ x, à +7, est en 0x31871 pour la première)
+	begin(0x31871 - 7);
+	for (int i = 0; i < 30; i++) {
+		const LoLMonster &m = _monsters[i];
+		u16(m.nextAssignedObject); u16(m.nextDrawObject); u8(m.flyingHeight); u16(m.block); u16(m.x); u16(m.y);
+		u8(m.destDirection); u8(m.shiftStep); u16(m.destX); u16(m.destY); u8(m.hitOffsX); u8(m.hitOffsY);
+		u8(m.currentSubFrame); u8(m.mode); u8(m.fightCurTick); u8(m.id); u8(m.direction); u8(m.facing);
+		u16(m.flags); u16(m.damageReceived); u16(m.hitPoints); u8(m.speedTick); u8(m.type); u32(0);
+		u8(m.numDistAttacks); u8(m.curDistWeapon); u8(m.distAttackTick); u16(m.assignedItems);
+		for (int k = 0; k < 4; k++) u8(m.equipmentShapes[k]);
+	}
+	end();
+
+	// groupe : 4 fiches de 130 octets (le nom, à +2, est en 0x3389F pour la première)
+	begin(0x3389F - 2);
+	for (int i = 0; i < 4; i++) {
+		const LoLCharacter &c = _characters[i];
+		u16(c.flags); for (int k = 0; k < 11; k++) u8(c.name[k]); u8(c.raceClassSex); u16(c.id);
+		u8(c.curFaceFrame); u8(c.tempFaceFrame); u8(c.screamSfx); u32(0);
+		for (int k = 0; k < 8; k++) u16(c.itemsMight[k]);
+		for (int k = 0; k < 8; k++) u16(c.protectionAgainstItems[k]);
+		u16(c.itemProtection); u16(c.hitPointsCur); u16(c.hitPointsMax); u16(c.magicPointsCur); u16(c.magicPointsMax);
+		u8(c.field_41); u16(c.damageSuffered); u16(c.weaponHit); u16(c.totalMightModifier); u16(c.totalProtectionModifier);
+		u16(c.might); u16(c.protection); u16(c.nextAnimUpdateCountdown);
+		for (int k = 0; k < 11; k++) u16(c.items[k]);
+		for (int k = 0; k < 3; k++) u8(c.skillLevels[k]);
+		for (int k = 0; k < 3; k++) u8(c.skillModifiers[k]);
+		for (int k = 0; k < 3; k++) u32(c.experiencePts[k]);
+		for (int k = 0; k < 5; k++) u8(c.characterUpdateEvents[k]);
+		for (int k = 0; k < 5; k++) u8(c.characterUpdateDelay[k]);
+	}
+	end();
+
+	EM_ASM({ if (Module.lolState) Module.lolState(HEAPU8.slice($0, $0 + $1)); }, buf.data(), buf.size());
+#endif
+}
